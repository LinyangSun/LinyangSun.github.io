---
/**
 * Stats4U visitor globe.
 * It counts new page loads and displays approximate visitor locations.
 * Do not substitute a generic demo site's counter ID.
 *
 * Stats4U: https://www.stats4u.net/en/globe
 * Public statistics: https://www.stats4u.net/live/5162609191
 *
 * The provider performs IP geolocation. Our GitHub Pages site does not
 * receive, publish, or persist individual visitor IP addresses.
 */
const counterId = "5162609191";
---

<section class="visitor-globe-panel" aria-label="Visitor locations around the world">
    <div class="visitor-globe-canvas" aria-label="Live 3D globe showing approximate visitor locations">
        <script
            is:inline
            data-astro-rerun
            async
            src="https://www.stats4u.net/js/globe.js"
            data-s4uid={counterId}
            data-size="210"
            data-lang="en"
            data-count="1"
        ></script>
    </div>
    <p class="visitor-globe-caption">
        Visitor locations · approximate
        <a
            href="https://www.stats4u.net/en/privacy"
            target="_blank"
            rel="noopener noreferrer"
            title="Stats4U privacy policy. IP addresses may be held in server logs for up to 14 days."
        >Privacy</a>
    </p>
</section>

<script>
    // Hide only the three Stats4U mode switches above the embedded globe.
    // The provider inserts these controls asynchronously after its script loads.
    let globeOptionsObserver: MutationObserver | null = null;

    function hideVisitorGlobeOptions() {
        const root = document.querySelector(".visitor-globe-canvas");
        if (!root) return;

        const controls = root.querySelectorAll<HTMLElement>(
            "button, label, [role='button'], [role='tab'], [tabindex]"
        );

        for (const control of controls) {
            const rawLabel = control.getAttribute("aria-label") || control.textContent || "";
            const label = rawLabel.replace(/\s+/g, " ").trim();
            if (/^(total visits|online now|online|cities|city)(?:\s*\(\d+\)|\s+\d+)?$/i.test(label)) {
                control.classList.add("visitor-globe-option-hidden");
            }
        }
    }

    function observeVisitorGlobeOptions() {
        globeOptionsObserver?.disconnect();
        globeOptionsObserver = null;
        const root = document.querySelector(".visitor-globe-canvas");
        if (!root) return;

        hideVisitorGlobeOptions();
        globeOptionsObserver = new MutationObserver(hideVisitorGlobeOptions);
        globeOptionsObserver.observe(root, { childList: true, subtree: true });
    }

    document.addEventListener("astro:page-load", observeVisitorGlobeOptions);
    document.addEventListener("astro:before-swap", () => {
        globeOptionsObserver?.disconnect();
        globeOptionsObserver = null;
    });
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", observeVisitorGlobeOptions, { once: true });
    } else {
        observeVisitorGlobeOptions();
    }
</script>
