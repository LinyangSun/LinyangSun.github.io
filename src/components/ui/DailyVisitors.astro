---
/**
 * Aggregate of Stats4U's daily unique visitor counts.
 * The globe already counts visits with data-count="1", so this read-only
 * stats request must never create a second counting event.
 *
 * "Unique" here is per counter, calendar day, IP address and user agent.
 * Repeat page loads within the day from the same browser count once;
 * the same visitor counts again on a later day.
 */
const statsUrl = "https://www.stats4u.net/live/5162609191";
---

<div class="sidebar-traffic" data-daily-visitors>
    <a
        class="pageviews-badge-link"
        href={statsUrl}
        target="_blank"
        rel="noopener noreferrer"
        title="Page views: daily unique visitor total. Repeated visits from the same browser on the same day count once."
        aria-label="Page views. Daily unique visitor total; open statistics."
    >
        <svg
            class="pageviews-badge"
            xmlns="http://www.w3.org/2000/svg"
            width="150"
            height="20"
            viewBox="0 0 150 20"
            role="img"
            aria-label="Page views, daily unique total"
        >
            <rect width="91" height="20" fill="#334155" />
            <rect x="91" width="59" height="20" fill="#64748b" />
            <text x="45.5" y="14" text-anchor="middle" fill="#fff" font-family="Verdana, sans-serif" font-size="11">Page views</text>
            <text x="120.5" y="14" text-anchor="middle" fill="#fff" font-family="Verdana, sans-serif" font-size="11" data-daily-visitors-value>—</text>
        </svg>
    </a>
</div>

<script>
    const statsApiUrl = "https://www.stats4u.net/live/5162609191/stats.json?days=400";
    let activeRequest: AbortController | null = null;

    async function updateDailyVisitors() {
        const valueElement = document.querySelector<HTMLElement>(
            "[data-daily-visitors-value]"
        );
        if (!valueElement) return;

        activeRequest?.abort();
        const controller = new AbortController();
        activeRequest = controller;

        try {
            const response = await fetch(statsApiUrl, {
                signal: controller.signal,
                cache: "default",
            });
            if (!response.ok) throw new Error("Statistics unavailable");

            const stats: { totals?: { unique?: number } } = await response.json();
            const visitorDays = stats?.totals?.unique;
            if (!Number.isSafeInteger(visitorDays) || visitorDays === undefined || visitorDays < 0) {
                throw new Error("Invalid visitor total");
            }
            if (!controller.signal.aborted) {
                valueElement.textContent = new Intl.NumberFormat("en").format(visitorDays);
            }
        } catch (error) {
            if (!controller.signal.aborted) {
                valueElement.textContent = "—";
                valueElement.setAttribute("title", "Visitor statistics temporarily unavailable");
            }
        } finally {
            if (activeRequest === controller) activeRequest = null;
        }
    }

    document.addEventListener("astro:page-load", updateDailyVisitors);
    document.addEventListener("astro:before-swap", () => activeRequest?.abort());
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", updateDailyVisitors, { once: true });
    } else {
        updateDailyVisitors();
    }
</script>
