---
/**
 * Cola: self-animated, pointer-transparent, local pixel cat.
 * One introductory nap per new site load. Astro navigation carries her
 * position/activity rather than replaying that introduction.
 */
---
<canvas
  class="cola-pet"
  data-cola-pet
  width="48"
  height="40"
  role="img"
  aria-label="Cola, a lively pixel black cat with yellow eyes and a tiny white chest tuft"
></canvas>
<span class="cola-avatar-poop" data-cola-poop aria-hidden="true">
  <svg viewBox="0 0 14 14" width="14" height="14" focusable="false">
    <path d="M2 10H12V12H2Z M3 8H11V10H3Z M5 6H10V8H5Z M6 4H9V6H6Z" fill="#70503d"/>
    <path d="M5 8H9V9H5Z M6 6H8V7H6Z" fill="#af8061"/>
    <rect x="5" y="10" width="2" height="1" fill="#a97b5d"/>
  </svg>
</span>

<script>
  type Point = { x: number; y: number };
  type Spot = "roam" | "bed" | "cloud" | "globe" | "wheel" | "ball" | "avatar";
  type Mode = "intro" | "walk" | "scene" | "startle" | "escape" | "hopout" | "chase" | "sprint" | "cursorApproach" | "cursorTap";
  type Pose = "sleep" | "sit" | "walk" | "run" | "startled" | "paw" | "jump" | "squat" | "bury";
  type Memory = {
    x: number;
    y: number;
    facing: number;
    mode: Mode;
    spot: Spot;
    destination: Spot;
    remaining: number;
    nextAvatarVisit: number;
    cursorPoint: Point | null;
    cursorAnchor: Point | null;
    cursorStationarySince: number;
    cursorVisitAfter: number;
    cursorSwats: number;
  };

  let colaCleanup: ((remember: boolean) => void) | null = null;
  let colaMemory: Memory | null = null;

  function mountCola() {
    colaCleanup?.(false);
    colaCleanup = null;

    const canvas = document.querySelector<HTMLCanvasElement>("[data-cola-pet]");
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return;

    const cloud = document.querySelector<HTMLElement>(".research-cloud-viewport");
    const globe = document.querySelector<HTMLElement>(".visitor-globe-canvas");
    const bed = document.querySelector<HTMLElement>("[data-cola-bed]");
    const wheel = document.querySelector<HTMLElement>("[data-cola-wheel]");
    const ball = document.querySelector<HTMLElement>("[data-cola-ball]");
    const avatar = document.querySelector<HTMLElement>(".sidebar-avatar");
    const poop = document.querySelector<HTMLElement>("[data-cola-poop]");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const random = (a: number, b: number) => a + Math.random() * (b - a);
    const clamp = (n: number, a: number, b: number) => Math.max(a, Math.min(b, n));
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const rect = (e: Element | null): DOMRect | null => e?.getBoundingClientRect() ?? null;
    const isVisible = (e: Element | null) => {
      const r = rect(e);
      return !!r && r.width > 25 && r.height > 25 &&
        r.bottom > 45 && r.top < window.innerHeight - 4 &&
        r.right > 20 && r.left < window.innerWidth - 20;
    };
    const pin = (p: Point): Point => ({
      x: clamp(p.x, 43, Math.max(44, window.innerWidth - 43)),
      y: clamp(p.y, 70, Math.max(71, window.innerHeight - 10)),
    });
    const spotElement = (s: Spot): HTMLElement | null => ({
      roam: null, bed, cloud, globe, wheel, ball, avatar
    })[s];

    function ballPosition(): Point | null {
      if (!ball || ball.dataset.held === "true") return null;
      const px = Number(ball.dataset.x);
      const py = Number(ball.dataset.y);
      if (!Number.isFinite(px) || !Number.isFinite(py)) return null;
      return pin({ x: px, y: py });
    }

    function spotPoint(s: Spot): Point {
      if (s === "ball") return ballPosition() ?? freePoint();
      const r = rect(spotElement(s));
      if (r) {
        if (s === "avatar") return pin({ x: r.left + r.width * .45, y: r.top + 10 });
        if (s === "bed") return pin({ x: r.left + r.width * .50, y: r.top + r.height * .72 });
        if (s === "cloud") return pin({ x: r.left + r.width * .50, y: r.top + 6 });
        if (s === "globe") return pin({ x: r.left + r.width * .62, y: r.top + r.height * .58 });
        if (s === "wheel") return pin({ x: r.left + r.width * .51, y: r.top + r.height * .72 });
      }
      return pin({ x: window.innerWidth * .45, y: window.innerHeight * .70 });
    }

    function freePoint(): Point {
      const w = window.innerWidth;
      const h = window.innerHeight;
      const choices = [
        { x: random(55, Math.max(57, w - 55)), y: h - 21 },
        { x: random(55, Math.max(57, w - 55)), y: random(h * .36, Math.max(h * .37, h * .74)) },
        { x: random(w * .38, Math.max(w * .39, w - 60)), y: random(94, Math.max(96, h - 32)) },
      ];
      return pin(choices[Math.floor(Math.random() * choices.length)]);
    }

    let x = Math.min(180, window.innerWidth * .30);
    let y = window.innerHeight - 22;
    let facing = 1;
    let mode: Mode = "intro";
    let pose: Pose = "sleep";
    let scene: Spot = "roam";
    let destination: Spot = "roam";
    let origin: Point = { x, y };
    let to: Point = { x, y };
    let travelStart = 0;
    let travelDuration = 1000;
    let endAt = 0;
    let wheelCooldown = 0;
    let scaredUntil = 0;
    let mouse: Point | null = null;
    // The pointer must stay within an 8px radius for 10 seconds.
    let cursorAnchor: Point | null = null;
    let cursorStationarySince = 0;
    let cursorVisitAfter = Number.POSITIVE_INFINITY;
    let cursorSwats = 0;
    let nextCursorSwat = 0;
    let cursorPawUntil = 0;
    let cursorPawStarted = 0;
    let cursorExitAt = 0;
    let raf = 0;
    let lastDraw = 0;
    let hiddenAt = 0;
    let cloudHopCount = 0;
    let nextCloudHop = 0;
    let hopStart = 0;
    let hopEnd = 0;
    let hopFrom: Point = { x, y };
    let hopTo: Point = { x, y };
    let wheelActive = false;
    let chaseHits = 0;
    let chaseLast = 0;
    let nextBallTap = 0;
    let swatUntil = 0;
    let chaseCooldown = 0;
    const avatarSceneDuration = 6400;
    let avatarSceneStart = 0;
    let nextAvatarVisit = performance.now() + random(17000, 28000);
    const encounterCooldown: Partial<Record<Spot, number>> = {};

    function setPoopVisible(show: boolean, burying = false) {
      if (!poop) return;
      poop.classList.toggle("is-visible", show);
      poop.classList.toggle("is-burying", show && burying);
      if (show) {
        poop.style.transform = "translate3d(" + Math.round(x + 26) + "px, " +
          Math.round(y - 9) + "px, 0)";
      }
    }

    function wheelOff() {
      wheelActive = false;
      wheel?.classList.remove("cola-wheel-running");
    }

    function chooseSpot(previous: Spot): Spot {
      // The avatar visit is an occasional event, not a constant loop.
      if (isVisible(avatar) && previous !== "avatar" && performance.now() >= nextAvatarVisit)
        return "avatar";
      const choices: Spot[] = ["roam", "roam", "roam"];
      if (isVisible(bed) && previous !== "bed") choices.push("bed", "bed");
      if (isVisible(globe) && previous !== "globe") choices.push("globe", "globe");
      if (isVisible(cloud) && previous !== "cloud") choices.push("cloud", "cloud");
      if (isVisible(wheel) && performance.now() > wheelCooldown && previous !== "wheel")
        choices.push("wheel", "wheel", "wheel");
      if (ballPosition() && performance.now() > chaseCooldown && previous !== "ball")
        choices.push("ball", "ball");
      return choices[Math.floor(Math.random() * choices.length)];
    }

    function walkTo(next: Spot, now: number, forced?: Point, run = false) {
      if (mode === "scene") encounterCooldown[scene] = now + 8000;
      setPoopVisible(false);
      if (next === "ball" && ballPosition()) {
        beginBallChase(now);
        return;
      }
      wheelOff();
      mode = run ? "escape" : next === "avatar" ? "sprint" : "walk";
      pose = run || next === "avatar" ? "run" : "walk";
      destination = next;
      origin = { x, y };
      to = pin(forced || (next === "roam" ? freePoint() : spotPoint(next)));
      travelStart = now;
      const distance = Math.hypot(to.x - x, to.y - y);
      travelDuration = clamp(
        distance / (run ? 370 : next === "avatar" ? 285 : random(95, 140)) * 1000,
        run || next === "avatar" ? 450 : 490,
        run ? 920 : next === "avatar" ? 2500 : 7400
      );
      facing = to.x >= x ? 1 : -1;
    }

    function cursorInteractionActive() {
      return mode === "cursorApproach" || mode === "cursorTap";
    }

    function canApproachCursor() {
      // Never interrupt a scheduled 5s wheel scene, avatar scene, ball chase,
      // initial nap, or a startled escape. Ordinary roaming may be interrupted.
      return mode !== "intro" && mode !== "chase" &&
        mode !== "startle" && mode !== "escape" &&
        mode !== "hopout" && mode !== "sprint" &&
        !(mode === "scene" && (scene === "wheel" || scene === "avatar"));
    }

    function approachCursor(now: number) {
      // Eligibility is checked at the idle trigger. Restoration after an
      // Astro page swap starts from the default 'intro' mode, so it must not
      // be rejected here.
      if (!mouse || !cursorAnchor) return;
      setPoopVisible(false);
      wheelOff();
      const side = x <= mouse.x ? -1 : 1;
      const landing = pin({x: mouse.x + side * 28, y: mouse.y + 31});
      mode = "cursorApproach";
      pose = "run";
      origin = {x, y};
      to = landing;
      travelStart = now;
      const distance = Math.hypot(to.x - x, to.y - y);
      travelDuration = clamp(distance / 270 * 1000, 480, 2900);
      facing = side === -1 ? 1 : -1;
      cursorSwats = 0;
    }

    function startCursorTaps(now: number) {
      mode = "cursorTap";
      pose = "sit";
      cursorSwats = 0;
      nextCursorSwat = now + 190;
      cursorPawUntil = 0;
      cursorPawStarted = 0;
      cursorExitAt = Number.POSITIVE_INFINITY;
    }

    function finishCursorTaps(now: number) {
      // If the pointer stays still, another visit is scheduled at random.
      cursorVisitAfter = now + random(19000, 42000);
      cursorSwats = 0;
      walkTo("roam", now);
    }

    function beginBallChase(now: number, remaining?: number) {
      if (!ballPosition()) return;
      setPoopVisible(false);
      wheelOff();
      mode = "chase";
      pose = "run";
      scene = "ball";
      destination = "ball";
      chaseHits = 0;
      nextBallTap = now + 360;
      chaseLast = now;
      swatUntil = 0;
      endAt = now + (remaining ?? 7200);
      // The pointer launching the ball should not instantly frighten Cola away.
      scaredUntil = now + 1500;
    }

    function onBallLaunched() {
      if (prefersReducedMotion.matches || window.innerWidth < 590) return;
      beginBallChase(performance.now(), 7800);
    }

    function startScene(next: Spot, now: number, remaining?: number) {
      scene = next;
      destination = next;
      mode = "scene";
      cloudHopCount = 0;
      nextCloudHop = now + 420;
      hopEnd = 0;
      setPoopVisible(false);
      if (next === "avatar") {
        const remainingTime = remaining ?? avatarSceneDuration;
        avatarSceneStart = now - Math.max(0, avatarSceneDuration - remainingTime);
        endAt = now + remainingTime;
        facing = -1;
        pose = "sit";
      } else if (next === "bed") {
        pose = "sleep";
        endAt = now + (remaining ?? 5000);
      } else if (next === "wheel") {
        pose = "run";
        endAt = now + (remaining ?? 5000);
        wheelActive = true;
        wheel?.classList.add("cola-wheel-running");
      } else if (next === "cloud") {
        pose = "sit";
        endAt = now + (remaining ?? 6500);
      } else if (next === "globe") {
        pose = "walk";
        endAt = now + (remaining ?? random(3500, 5800));
      } else {
        pose = "sit";
        endAt = now + (remaining ?? random(1400, 3600));
      }
    }

    function cloudSteps(): Point[] {
      const area = rect(cloud);
      if (!area || !cloud) return [];
      const raw = cloud.querySelector<HTMLCanvasElement>(".research-cloud-canvas")?.dataset.colaSteps;
      if (!raw) return [];
      try {
        const steps: unknown = JSON.parse(raw);
        if (!Array.isArray(steps)) return [];
        return steps.filter((p: any) => Number.isFinite(p.x) && Number.isFinite(p.y) && p.depth > .35)
          .map((p: any) => pin({ x: area.left + p.x, y: area.top + p.y - 5 }));
      } catch { return []; }
    }

    function beginCloudHop(now: number) {
      const list = cloudSteps();
      const area = rect(cloud);
      const next = list.length
        ? list[Math.floor(Math.random() * list.length)]
        : area
          ? pin({ x: random(area.left + 38, area.right - 34), y: random(area.top + 24, area.bottom - 12) })
          : freePoint();
      cloudHopCount++;
      hopFrom = { x, y };
      hopTo = next;
      facing = next.x >= x ? 1 : -1;
      hopStart = now;
      hopEnd = now + 440;
      nextCloudHop = now + 820;
      pose = "jump";
    }

    function startle(now: number) {
      if (mode === "startle" || mode === "escape" || mode === "hopout" || now < scaredUntil) return;
      if (mode === "scene" && scene === "avatar") nextAvatarVisit = now + 35000;
      setPoopVisible(false);
      wheelOff();
      mode = "startle";
      pose = "startled";
      endAt = now + 285;
      scaredUntil = now + 2400;
      // Draw synchronously. There is no delayed reaction to the pointer.
      paint(now);
    }

    function finishWheel(now: number) {
      wheelOff();
      wheelCooldown = now + 14500;
      encounterCooldown.wheel = wheelCooldown;
      scene = "wheel";
      mode = "hopout";
      pose = "jump";
      origin = { x, y };
      to = pin({ x: x + (facing < 0 ? -105 : 105), y: y + random(12, 45) });
      facing = to.x >= x ? 1 : -1;
      travelStart = now;
      travelDuration = 780;
      destination = "roam";
    }

    function nearWheel() {
      if (!isVisible(wheel)) return false;
      const p = spotPoint("wheel");
      return Math.hypot(p.x - x, p.y - y) < 42;
    }

    function advance(now: number) {
      if (mouse && cursorAnchor && cursorStationarySince > 0 &&
          now - cursorStationarySince >= 10000 &&
          now >= cursorVisitAfter && canApproachCursor() &&
          !cursorInteractionActive()) {
        approachCursor(now);
      }

      // Cola deliberately approaches the idle pointer without being startled
      // by the proximity rule that applies during all ordinary activities.
      if (mouse && !cursorInteractionActive() &&
          mode !== "startle" && mode !== "escape" &&
          mode !== "hopout" && mode !== "chase") {
        if (Math.hypot(x - mouse.x, y - 29 - mouse.y) < 90) {
          startle(now);
          if (mode === "startle") return;
        }
      }

      if (mode === "cursorApproach") {
        const progress = clamp((now - travelStart) / travelDuration, 0, 1);
        const eased = progress * progress * (3 - 2 * progress);
        x = lerp(origin.x, to.x, eased);
        y = lerp(origin.y, to.y, eased);
        pose = "run";
        if (progress >= 1) startCursorTaps(now);
        return;
      }

      if (mode === "cursorTap") {
        if (!mouse) {
          finishCursorTaps(now);
          return;
        }
        // Stay beside the cursor, lifting the front paw exactly twice.
        pose = now < cursorPawUntil ? "paw" : "sit";
        if (cursorSwats < 2 && now >= nextCursorSwat) {
          cursorSwats++;
          pose = "paw";
          cursorPawStarted = now;
          cursorPawUntil = now + 430;
          nextCursorSwat = now + 850;
          if (cursorSwats === 2) cursorExitAt = now + 1070;
        }
        if (cursorSwats === 2 && now >= cursorExitAt) {
          finishCursorTaps(now);
        }
        return;
      }

      if (mode === "chase") {
        const toy = ballPosition();
        const dt = Math.min(Math.max(now - chaseLast, 0), 66) / 1000;
        chaseLast = now;
        if (!toy) {
          pose = "sit";
          if (now >= endAt) walkTo("roam", now);
          return;
        }
        // Follow the moving ball rather than its original launch position.
        const want = pin({
          x: toy.x + (x > toy.x ? 19 : -19),
          y: toy.y + 18,
        });
        const dx = want.x - x;
        const dy = want.y - y;
        const distance = Math.hypot(dx, dy);
        if (distance > 1) {
          const travel = Math.min(distance, 330 * dt);
          x += dx / distance * travel;
          y += dy / distance * travel;
          if (Math.abs(dx) > 3) facing = dx > 0 ? 1 : -1;
        }
        pose = now < swatUntil ? "paw" : "run";
        if (now >= nextBallTap && Math.hypot(x - toy.x, y - 18 - toy.y) < 42) {
          window.dispatchEvent(new CustomEvent("cola:ball-batted", {
            detail: { fromX: x, fromY: y - 18, direction: facing }
          }));
          chaseHits++;
          nextBallTap = now + 1100;
          swatUntil = now + 260;
          pose = "paw";
        }
        if (now >= endAt || chaseHits >= 3) {
          chaseCooldown = now + 6500;
          walkTo("roam", now);
        }
        return;
      }

      if (mode === "intro") {
        pose = "sleep";
        if (now >= endAt) walkTo(chooseSpot("cloud"), now);
      } else if (mode === "startle") {
        pose = "startled";
        if (now >= endAt) {
          const away = mouse
            ? pin({ x: x + (x >= mouse.x ? 1 : -1) * 200, y: y + (y >= mouse.y ? 1 : -1) * 55 })
            : freePoint();
          walkTo("roam", now, away, true);
        }
      } else if (mode === "walk" || mode === "escape" || mode === "hopout" || mode === "sprint") {
        const progress = clamp((now - travelStart) / travelDuration, 0, 1);
        const ease = mode === "hopout" ? progress : progress * progress * (3 - 2 * progress);
        x = lerp(origin.x, to.x, ease);
        y = lerp(origin.y, to.y, ease);
        // Ordinary walking stays on the ground: only the wheel exit is a jump.
        if (mode === "hopout") y -= 36 * Math.sin(Math.PI * progress);
        pose = mode === "hopout" ? "jump" : mode === "escape" || mode === "sprint" ? "run" : "walk";

        // A scene starts on contact, even if Cola was headed somewhere else.
        // Recently visited spots are ignored briefly to avoid getting stuck.
        if (mode === "walk") {
          const toy = ballPosition();
          if (toy && now >= chaseCooldown &&
              Math.hypot(toy.x - x, toy.y - (y - 18)) < 43) {
            beginBallChase(now);
            return;
          }
          const encounters: Spot[] = ["wheel", "bed", "cloud", "globe"];
          for (const spot of encounters) {
            if (!isVisible(spotElement(spot)) ||
                now < (encounterCooldown[spot] || 0) ||
                (spot === "wheel" && now < wheelCooldown)) continue;
            const place = spotPoint(spot);
            const threshold = spot === "globe" ? 53 : spot === "wheel" ? 52 : 39;
            if (Math.hypot(place.x - x, place.y - y) <= threshold) {
              if (spot === "wheel") { x = place.x; y = place.y; }
              startScene(spot, now);
              return;
            }
          }
        }

        if (progress >= 1) {
          if (mode === "escape" || mode === "hopout") {
            startScene("roam", now);
          } else if (destination !== "roam" && isVisible(spotElement(destination))) {
            startScene(destination, now);
          } else {
            startScene("roam", now);
          }
        }
      } else if (mode === "scene") {
        if (scene === "avatar") {
          if (!isVisible(avatar)) {
            setPoopVisible(false);
            nextAvatarVisit = now + 60000;
            walkTo("roam", now);
            return;
          }
          const perch = spotPoint("avatar");
          x = lerp(x, perch.x, .18);
          y = lerp(y, perch.y, .18);
          const elapsed = now - avatarSceneStart;
          if (elapsed < 750) {
            pose = "sit";
            facing = -1;
            setPoopVisible(false);
          } else if (elapsed < 2250) {
            pose = "squat";
            facing = -1;
            setPoopVisible(false);
          } else if (elapsed < 3100) {
            pose = "squat";
            facing = -1;
            setPoopVisible(true);
          } else if (elapsed < 5480) {
            pose = "bury";
            facing = 1;
            setPoopVisible(true, true);
          } else {
            pose = "sit";
            facing = 1;
            setPoopVisible(false);
          }
          if (now >= endAt) {
            setPoopVisible(false);
            nextAvatarVisit = now + random(75000, 120000);
            walkTo("roam", now);
          }
        } else if (scene === "wheel") {
          pose = "run";
          const w = spotPoint("wheel");
          x = lerp(x, w.x, .13);
          y = lerp(y, w.y, .13);
          if (now >= endAt) finishWheel(now);
        } else if (scene === "bed") {
          pose = "sleep";
          const p = spotPoint("bed");
          x = lerp(x, p.x, .06); y = lerp(y, p.y, .06);
          if (now >= endAt) walkTo(chooseSpot("bed"), now);
        } else if (scene === "cloud") {
          if (cloudHopCount < 5 && now >= nextCloudHop) beginCloudHop(now);
          if (now < hopEnd) {
            const t = clamp((now - hopStart) / 440, 0, 1);
            x = lerp(hopFrom.x, hopTo.x, t);
            y = lerp(hopFrom.y, hopTo.y, t) - 21 * Math.sin(Math.PI * t);
            pose = "jump";
          } else if (cloudHopCount >= 5) {
            walkTo(chooseSpot("cloud"), now);
          } else {
            pose = "sit";
          }
        } else if (scene === "globe") {
          pose = "walk";
          const g = rect(globe);
          if (g && isVisible(globe)) {
            const elapsed = endAt - now;
            const angle = now / 420;
            const centerX = g.left + g.width * .54;
            const centerY = g.top + g.height * .57;
            x = lerp(x, centerX + Math.cos(angle) * g.width * .21, .11);
            y = lerp(y, centerY + Math.sin(angle) * g.height * .15, .11);
            facing = Math.sin(angle) > 0 ? -1 : 1;
          }
          if (now >= endAt) walkTo(chooseSpot("globe"), now);
        } else {
          pose = "sit";
          if (now >= endAt) walkTo(chooseSpot("roam"), now);
        }
      }
    }

    // Original tiny pixel sprites inspired by Cola's reference sheet.
    // All poses use a 24 x 20 grid (2 canvas pixels per art pixel).
    // A walking cat always has a side-facing body; only the sitting pose
    // occasionally turns her face toward the viewer.
    function paint(now: number) {
      ctx!.clearRect(0, 0, 48, 40);
      ctx!.imageSmoothingEnabled = false;
      ctx!.save();
      // Art is drawn with the head on the left; flip when she walks right.
      if (facing > 0) { ctx!.translate(48, 0); ctx!.scale(-1, 1); }

      const ink = "#101018";
      const fur = "#292a35";
      const shade = "#434551";
      const glint = "#5a5b67";
      const yellow = "#f8e24f";
      const nose = "#e0acb4";
      const white = "#f6f5f2";
      const p = (x: number, y: number, w: number, h: number, color: string) => {
        ctx!.fillStyle = color;
        ctx!.fillRect(Math.round(x) * 2, Math.round(y) * 2, w * 2, h * 2);
      };
      const frame = Math.floor(now / (pose === "run" ? 82 : 165)) % 4;
      const blink = pose !== "startled" &&
        Math.floor(now / 3000) % 5 === 0 && Math.floor(now / 145) % 5 === 0;
      const pairOfEyes = (lx: number, rx: number, yy: number, size = 2) => {
        if (blink) {
          p(lx, yy + 1, size, 1, glint);
          p(rx, yy + 1, size, 1, glint);
        } else {
          p(lx, yy, size, 2, yellow);
          p(rx, yy, size, 2, yellow);
        }
      };

      if (pose === "sit" && Math.floor(now / 4800) % 3 !== 2) {
        // Front-facing sitting cat with both paws planted and a swishing tail.
        const wag = Math.round(Math.sin(now / 410));
        p(16, 12, 3, 6, ink); p(18, 9, 2, 5, fur);
        p(19, 6 + wag, 2, 5, ink); p(19, 5 + wag, 3, 2, ink);
        p(8, 11, 9, 7, ink); p(9, 12, 7, 5, fur);
        p(9, 13, 2, 5, shade); p(14, 13, 2, 5, shade);
        p(8, 17, 3, 2, ink); p(14, 17, 3, 2, ink);
        p(7, 2, 3, 5, ink); p(15, 2, 3, 5, ink);
        p(8, 3, 1, 2, shade); p(16, 3, 1, 2, shade);
        p(6, 6, 13, 8, ink); p(7, 7, 11, 6, fur);
        p(8, 7, 9, 1, shade);
        pairOfEyes(9, 14, 9);
        p(12, 12, 1, 1, nose);
        // A single white pixel on the visible chest below the face.
        p(12, 15, 1, 1, white);
      } else if (pose === "sleep") {
        // Curled cat with ears lowered and eyes closed.
        p(18, 15, 3, 3, ink); p(20, 13, 2, 4, ink);
        p(21, 11 + Math.round(Math.sin(now / 750)), 2, 3, fur);
        p(7, 13, 14, 6, ink); p(9, 12, 10, 6, fur);
        p(11, 13, 5, 1, shade);
        p(3, 10, 4, 4, ink); p(9, 10, 3, 4, ink);
        p(2, 12, 11, 6, ink); p(3, 13, 9, 4, fur);
        p(4, 13, 6, 1, shade);
        p(5, 15, 2, 1, glint); p(9, 15, 2, 1, glint);
        p(7, 17, 1, 1, nose); p(11, 16, 1, 1, white);
      } else if (pose === "jump") {
        // Fully extended flying leap, not the standing cat moved upward.
        p(18, 8, 4, 3, ink); p(21, 6, 2, 3, ink);
        p(22, 4, 2, 3, fur);
        p(8, 9, 12, 5, ink); p(9, 10, 10, 3, fur);
        p(12, 10, 5, 1, shade);
        p(16, 12, 5, 3, ink); p(20, 14, 3, 2, ink);
        p(10, 12, 4, 3, ink); p(8, 14, 4, 2, ink);
        p(0, 13, 4, 3, ink); p(1, 16, 3, 2, ink);
        p(3, 7, 3, 5, ink); p(8, 7, 3, 5, ink);
        p(2, 9, 10, 6, ink); p(3, 10, 8, 4, fur);
        pairOfEyes(4, 8, 11);
        p(7, 13, 1, 1, nose); p(10, 14, 1, 1, white);
      } else if (pose === "startled") {
        // Arched back, bottlebrush tail, wide eyes and two alarm pixels.
        p(20, 10, 3, 7, ink); p(21, 4, 2, 7, ink);
        p(22, 3, 2, 3, shade);
        p(10, 10, 11, 6, ink); p(12, 8, 8, 7, ink);
        p(12, 10, 8, 5, fur);
        p(12, 15, 2, 4, ink); p(18, 15, 2, 4, ink);
        p(10, 13, 2, 4, ink);
        p(2, 2, 3, 7, ink); p(8, 1, 3, 8, ink);
        p(3, 4, 1, 4, shade); p(9, 3, 1, 4, shade);
        p(2, 7, 10, 8, ink); p(3, 8, 8, 6, fur);
        p(4, 9, 2, 3, yellow); p(8, 9, 2, 3, yellow);
        p(7, 12, 1, 1, nose); p(10, 13, 1, 1, white);
        p(13, 4, 2, 2, "#d88e55"); p(13, 1, 2, 2, "#d88e55");
      } else if (pose === "squat") {
        // Low crouch with a raised tail, a separate silhouette for this scene.
        p(19, 12, 3, 5, ink); p(21, 7, 2, 7, ink); p(22, 5, 2, 4, fur);
        p(9, 11, 11, 6, ink); p(10, 12, 10, 5, fur);
        p(12, 16, 8, 3, ink); p(7, 15, 4, 4, ink);
        p(2, 4, 3, 5, ink); p(8, 4, 3, 5, ink);
        p(2, 8, 10, 7, ink); p(3, 9, 8, 5, fur);
        p(4, 10, 2, 2, yellow); p(8, 10, 2, 2, yellow);
        p(7, 13, 1, 1, nose); p(10, 14, 1, 1, white);
      } else if (pose === "sit") {
        // A second sitting silhouette, head turned sideways.
        const wag = Math.round(Math.sin(now / 390));
        p(18, 13, 3, 5, ink); p(20, 9 + wag, 2, 6, ink);
        p(21, 6 + wag, 2, 4, fur);
        p(10, 12, 10, 6, ink); p(11, 13, 8, 4, fur);
        p(10, 17, 4, 2, ink); p(17, 17, 3, 2, ink);
        p(11, 14, 1, 1, white);
        p(3, 4, 3, 5, ink); p(9, 4, 3, 5, ink);
        p(3, 7, 10, 8, ink); p(4, 8, 8, 5, fur);
        p(5, 9, 2, 2, yellow); p(9, 9, 2, 2, yellow);
        p(8, 12, 1, 1, nose);
      } else {
        // Standing, walking, running and pawing share one readable side-view.
        // Four gait frames use alternating diagonal leg pairs.
        const moving = pose === "walk" || pose === "run";
        const stride = moving
          ? (pose === "run" ? [-3, 1, 3, -1] : [-2, 0, 2, 0])[frame]
          : 0;
        const lift = moving && frame % 2 ? 1 : 0;
        const wag = Math.round(Math.sin(now / 370));
        p(18, 12 + lift, 3, 4, ink);
        p(20, 9 + wag, 2, 5, ink); p(21, 5 + wag, 2, 5, ink);
        p(22, 4 + wag, 2, 2, fur);
        // Rear pair behind the torso.
        p(11 - stride, 15 + lift, 2, 4 - lift, shade);
        p(18 + stride, 15 + lift, 2, 4 - lift, shade);
        p(8, 9 + lift, 12, 7, ink); p(9, 10 + lift, 10, 5, fur);
        p(10, 10 + lift, 7, 1, shade);
        // Foreground paws show the opposite phase, with small foot shifts.
        p(11 + stride, 15 + lift, 2, 4 - lift, ink);
        p(18 - stride, 15 + lift, 2, 4 - lift, ink);
        p(10 + stride, 18, 4, 2, ink);
        p(17 - stride, 18, 4, 2, ink);
        p(2, 3 + lift, 3, 5, ink); p(8, 3 + lift, 3, 5, ink);
        p(3, 4 + lift, 1, 2, shade); p(9, 4 + lift, 1, 2, shade);
        p(2, 7 + lift, 10, 7, ink); p(3, 8 + lift, 8, 5, fur);
        p(4, 8 + lift, 6, 1, shade);
        pairOfEyes(4, 8, 9 + lift);
        p(7, 12 + lift, 1, 1, nose);
        p(10, 13 + lift, 1, 1, white);
        if (pose === "paw") {
          if (mode === "cursorTap" && now < cursorPawUntil) {
            // Three distinct pixel-art frames: wind up, long forward swat,
            // then retract. The paw projects 11 logical pixels forward
            // from the shoulder, while the other foreleg stays planted.
            const swipeAge = now - cursorPawStarted;
            p(10, 14, 4, 3, shade); // shoulder joint
            if (swipeAge < 105) {
              // Bent foreleg, paw raised beside the muzzle.
              p(7, 11, 5, 4, fur);
              p(5, 9, 4, 4, ink);
              p(6, 9, 2, 1, glint);
            } else if (swipeAge < 315) {
              // Long straight foreleg and clear, squared-off paw tip.
              p(7, 15, 6, 2, fur);
              p(3, 15, 6, 2, ink);
              p(0, 14, 4, 4, fur);
              p(0, 15, 2, 1, shade);
              // Two impact ticks next to the mouse cursor.
              p(0, 11, 1, 2, "#f6d36b");
              p(2, 12, 2, 1, "#f6d36b");
              p(0, 19, 2, 1, "#f6d36b");
            } else {
              // Pull back to the shoulder before the next strike.
              p(7, 13, 6, 3, fur);
              p(5, 12, 4, 4, ink);
              p(5, 12, 2, 1, glint);
            }
          } else {
            // The subtler paw motion remains for globe and ball play.
            p(8, 14, 3, 3, fur);
            p(6, 12 + (frame % 2), 3, 3, ink);
          }
        }
        if (pose === "bury") {
          // Alternating rapid forward sweeps and tiny dusty pixel particles.
          const scratch = Math.floor(now / 145) % 4;
          p(8 - scratch, 14, 3, 3, fur);
          p(5 - scratch, 16 + (scratch % 2), 4, 2, ink);
          p(3 - scratch, 18, 2, 1, "#96725b");
          p(7 - (scratch % 3), 19, 1, 1, "#bc9780");
        }
      }
      ctx!.restore();
    }

    function display(now: number) {
      const bounce = pose === "run" ? Math.round(Math.sin(now / 76)) : 0;
      canvas!.style.transform = "translate3d(" + Math.round(x - 38) + "px, " +
        Math.round(y - 64 - bounce) + "px, 0)";
      paint(now);
    }

    function tick(now: number) {
      raf = requestAnimationFrame(tick);
      if (document.visibilityState !== "visible") return;
      if (now - lastDraw < 30) return;
      lastDraw = now;
      advance(now);
      display(now);
    }

    function pointerMoved(event: PointerEvent) {
      if (event.pointerType !== "mouse") return;
      const now = performance.now();
      const newPoint = {x: event.clientX, y: event.clientY};
      const moved = !cursorAnchor ||
        Math.hypot(cursorAnchor.x - newPoint.x, cursorAnchor.y - newPoint.y) > 8;
      mouse = newPoint;
      if (moved) {
        cursorAnchor = newPoint;
        cursorStationarySince = now;
        cursorVisitAfter = now + 10000;
        // Moving the mouse away interrupts a visit; the existing startle
        // reaction then makes Cola flee instead of continuing to strike.
        if (cursorInteractionActive()) {
          startle(now);
          return;
        }
      }
      if (!cursorInteractionActive() &&
          Math.hypot(x - mouse.x, y - 29 - mouse.y) < 90) {
        startle(now);
      }
    }
    function pointerLeft(event: PointerEvent) {
      // Ignore pointerout events while moving between ordinary page elements.
      if (event.relatedTarget) return;
      mouse = null;
      cursorAnchor = null;
      cursorStationarySince = 0;
      cursorVisitAfter = Number.POSITIVE_INFINITY;
      if (cursorInteractionActive()) walkTo("roam", performance.now());
    }
    function visibilityChanged() {
      if (document.visibilityState === "hidden") {
        hiddenAt = performance.now();
      } else if (hiddenAt) {
        const elapsed = performance.now() - hiddenAt;
        endAt += elapsed;
        avatarSceneStart += elapsed;
        nextAvatarVisit += elapsed;
        if (cursorStationarySince) cursorStationarySince += elapsed;
        if (Number.isFinite(cursorVisitAfter)) cursorVisitAfter += elapsed;
        nextCursorSwat += elapsed;
        cursorPawUntil += elapsed;
        if (cursorPawStarted) cursorPawStarted += elapsed;
        if (Number.isFinite(cursorExitAt)) cursorExitAt += elapsed;
        travelStart += elapsed;
        nextCloudHop += elapsed;
        hopStart += elapsed;
        hopEnd += elapsed;
        hiddenAt = 0;
      }
    }

    window.addEventListener("cola:ball-launched", onBallLaunched);
    window.addEventListener("pointermove", pointerMoved, { passive: true });
    window.addEventListener("pointerout", pointerLeft, { passive: true });
    document.addEventListener("visibilitychange", visibilityChanged);

    const now = performance.now();
    if (colaMemory) {
      // Astro client-side navigation preserves Cola's position and activity.
      const memory = colaMemory;
      colaMemory = null;
      x = pin({ x: memory.x, y: memory.y }).x;
      y = pin({ x: memory.x, y: memory.y }).y;
      facing = memory.facing;
      nextAvatarVisit = memory.nextAvatarVisit || (now + random(17000, 28000));
      mouse = memory.cursorPoint;
      cursorAnchor = memory.cursorAnchor;
      cursorStationarySince = memory.cursorStationarySince;
      cursorVisitAfter = memory.cursorVisitAfter;
      if (memory.mode === "cursorApproach" && mouse) {
        approachCursor(now);
      } else if (memory.mode === "cursorTap" && mouse) {
        startCursorTaps(now);
        cursorSwats = memory.cursorSwats;
        if (cursorSwats === 2) cursorExitAt = now + 450;
      } else if (memory.mode === "scene" && memory.spot !== "roam" &&
          isVisible(spotElement(memory.spot))) {
        startScene(memory.spot, now, Math.max(300, memory.remaining));
      } else if (memory.mode === "chase" && ballPosition()) {
        beginBallChase(now, Math.max(800, memory.remaining));
      } else if (memory.mode === "walk" || memory.mode === "escape" ||
          memory.mode === "hopout" || memory.mode === "sprint") {
        walkTo(memory.destination, now);
        travelDuration = Math.max(350, memory.remaining);
      } else {
        startScene("roam", now, Math.min(Math.max(memory.remaining, 500), 2600));
      }
    } else {
      // Exactly one entrance scene when the website is first loaded.
      const first = isVisible(cloud) ? spotPoint("cloud") : isVisible(bed) ? spotPoint("bed") : pin({ x, y });
      x = first.x; y = first.y;
      mode = "intro";
      pose = "sleep";
      scene = "cloud";
      destination = "cloud";
      endAt = now + random(3200, 5000);
    }
    display(now);

    if (!prefersReducedMotion.matches && window.innerWidth >= 590) {
      raf = requestAnimationFrame(tick);
    }

    colaCleanup = (remember: boolean) => {
      if (remember) colaMemory = {
        x, y, facing, mode, spot: scene, destination,
        nextAvatarVisit,
        cursorPoint: mouse,
        cursorAnchor,
        cursorStationarySince,
        cursorVisitAfter,
        cursorSwats,
        remaining: mode === "walk" || mode === "escape" || mode === "hopout" || mode === "sprint" ||
          mode === "cursorApproach"
          ? Math.max(0, travelDuration - (performance.now() - travelStart))
          : Math.max(0, endAt - performance.now()),
      };
      cancelAnimationFrame(raf);
      wheelOff();
      setPoopVisible(false);
      window.removeEventListener("cola:ball-launched", onBallLaunched);
      window.removeEventListener("pointermove", pointerMoved);
      window.removeEventListener("pointerout", pointerLeft);
      document.removeEventListener("visibilitychange", visibilityChanged);
    };
  }

  document.addEventListener("astro:page-load", mountCola);
  document.addEventListener("astro:before-swap", () => {
    colaCleanup?.(true);
    colaCleanup = null;
  });
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", mountCola, { once: true });
  } else {
    mountCola();
  }
</script>
