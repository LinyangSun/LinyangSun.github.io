---
/**
 * Cola: self-animated, pointer-transparent, local pixel cat.
 * One introductory nap per new site load. Astro navigation carries her
 * position/activity rather than replaying that introduction.
 */
---
<canvas
  class="cola-pet"
  data-cola-pet
  width="48"
  height="40"
  role="img"
  aria-label="Cola, a lively pixel black cat with yellow eyes and a tiny white chest tuft"
></canvas>

<script>
  type Point = { x: number; y: number };
  type Spot = "roam" | "bed" | "cloud" | "globe" | "wheel";
  type Mode = "intro" | "walk" | "scene" | "startle" | "escape" | "hopout";
  type Pose = "sleep" | "sit" | "walk" | "run" | "startled" | "paw" | "jump";
  type Memory = {
    x: number;
    y: number;
    facing: number;
    mode: Mode;
    spot: Spot;
    destination: Spot;
    remaining: number;
  };

  let colaCleanup: ((remember: boolean) => void) | null = null;
  let colaMemory: Memory | null = null;

  function mountCola() {
    colaCleanup?.(false);
    colaCleanup = null;

    const canvas = document.querySelector<HTMLCanvasElement>("[data-cola-pet]");
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return;

    const cloud = document.querySelector<HTMLElement>(".research-cloud-viewport");
    const globe = document.querySelector<HTMLElement>(".visitor-globe-canvas");
    const bed = document.querySelector<HTMLElement>("[data-cola-bed]");
    const wheel = document.querySelector<HTMLElement>("[data-cola-wheel]");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const random = (a: number, b: number) => a + Math.random() * (b - a);
    const clamp = (n: number, a: number, b: number) => Math.max(a, Math.min(b, n));
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const rect = (e: Element | null): DOMRect | null => e?.getBoundingClientRect() ?? null;
    const isVisible = (e: Element | null) => {
      const r = rect(e);
      return !!r && r.width > 25 && r.height > 25 &&
        r.bottom > 45 && r.top < window.innerHeight - 4 &&
        r.right > 20 && r.left < window.innerWidth - 20;
    };
    const pin = (p: Point): Point => ({
      x: clamp(p.x, 43, Math.max(44, window.innerWidth - 43)),
      y: clamp(p.y, 70, Math.max(71, window.innerHeight - 10)),
    });
    const spotElement = (s: Spot): HTMLElement | null => ({
      roam: null, bed, cloud, globe, wheel
    })[s];

    function spotPoint(s: Spot): Point {
      const r = rect(spotElement(s));
      if (r) {
        if (s === "bed") return pin({ x: r.left + r.width * .50, y: r.top + r.height * .72 });
        if (s === "cloud") return pin({ x: r.left + r.width * .50, y: r.top + 6 });
        if (s === "globe") return pin({ x: r.left + r.width * .62, y: r.top + r.height * .58 });
        if (s === "wheel") return pin({ x: r.left + r.width * .51, y: r.top + r.height * .72 });
      }
      return pin({ x: window.innerWidth * .45, y: window.innerHeight * .70 });
    }

    function freePoint(): Point {
      const w = window.innerWidth;
      const h = window.innerHeight;
      const choices = [
        { x: random(55, Math.max(57, w - 55)), y: h - 21 },
        { x: random(55, Math.max(57, w - 55)), y: random(h * .36, Math.max(h * .37, h * .74)) },
        { x: random(w * .38, Math.max(w * .39, w - 60)), y: random(94, Math.max(96, h - 32)) },
      ];
      return pin(choices[Math.floor(Math.random() * choices.length)]);
    }

    let x = Math.min(180, window.innerWidth * .30);
    let y = window.innerHeight - 22;
    let facing = 1;
    let mode: Mode = "intro";
    let pose: Pose = "sleep";
    let scene: Spot = "roam";
    let destination: Spot = "roam";
    let origin: Point = { x, y };
    let to: Point = { x, y };
    let travelStart = 0;
    let travelDuration = 1000;
    let endAt = 0;
    let wheelCooldown = 0;
    let scaredUntil = 0;
    let mouse: Point | null = null;
    let raf = 0;
    let lastDraw = 0;
    let hiddenAt = 0;
    let cloudHopCount = 0;
    let nextCloudHop = 0;
    let hopStart = 0;
    let hopEnd = 0;
    let hopFrom: Point = { x, y };
    let hopTo: Point = { x, y };
    let wheelActive = false;
    const encounterCooldown: Partial<Record<Spot, number>> = {};

    function wheelOff() {
      wheelActive = false;
      wheel?.classList.remove("cola-wheel-running");
    }

    function chooseSpot(previous: Spot): Spot {
      const choices: Spot[] = ["roam", "roam", "roam"];
      if (isVisible(bed) && previous !== "bed") choices.push("bed", "bed");
      if (isVisible(globe) && previous !== "globe") choices.push("globe", "globe");
      if (isVisible(cloud) && previous !== "cloud") choices.push("cloud", "cloud");
      if (isVisible(wheel) && performance.now() > wheelCooldown && previous !== "wheel")
        choices.push("wheel", "wheel", "wheel");
      return choices[Math.floor(Math.random() * choices.length)];
    }

    function walkTo(next: Spot, now: number, forced?: Point, run = false) {
      if (mode === "scene") encounterCooldown[scene] = now + 8000;
      wheelOff();
      mode = run ? "escape" : "walk";
      pose = run ? "run" : "walk";
      destination = next;
      origin = { x, y };
      to = pin(forced || (next === "roam" ? freePoint() : spotPoint(next)));
      travelStart = now;
      const distance = Math.hypot(to.x - x, to.y - y);
      travelDuration = clamp(distance / (run ? 370 : random(95, 140)) * 1000, run ? 360 : 490, run ? 920 : 7400);
      facing = to.x >= x ? 1 : -1;
    }

    function startScene(next: Spot, now: number, remaining?: number) {
      scene = next;
      destination = next;
      mode = "scene";
      cloudHopCount = 0;
      nextCloudHop = now + 420;
      hopEnd = 0;
      if (next === "bed") {
        pose = "sleep";
        endAt = now + (remaining ?? 5000);
      } else if (next === "wheel") {
        pose = "run";
        endAt = now + (remaining ?? 5000);
        wheelActive = true;
        wheel?.classList.add("cola-wheel-running");
      } else if (next === "cloud") {
        pose = "sit";
        endAt = now + (remaining ?? 6500);
      } else if (next === "globe") {
        pose = "walk";
        endAt = now + (remaining ?? random(3500, 5800));
      } else {
        pose = "sit";
        endAt = now + (remaining ?? random(1400, 3600));
      }
    }

    function cloudSteps(): Point[] {
      const area = rect(cloud);
      if (!area || !cloud) return [];
      const raw = cloud.querySelector<HTMLCanvasElement>(".research-cloud-canvas")?.dataset.colaSteps;
      if (!raw) return [];
      try {
        const steps: unknown = JSON.parse(raw);
        if (!Array.isArray(steps)) return [];
        return steps.filter((p: any) => Number.isFinite(p.x) && Number.isFinite(p.y) && p.depth > .35)
          .map((p: any) => pin({ x: area.left + p.x, y: area.top + p.y - 5 }));
      } catch { return []; }
    }

    function beginCloudHop(now: number) {
      const list = cloudSteps();
      const area = rect(cloud);
      const next = list.length
        ? list[Math.floor(Math.random() * list.length)]
        : area
          ? pin({ x: random(area.left + 38, area.right - 34), y: random(area.top + 24, area.bottom - 12) })
          : freePoint();
      cloudHopCount++;
      hopFrom = { x, y };
      hopTo = next;
      facing = next.x >= x ? 1 : -1;
      hopStart = now;
      hopEnd = now + 440;
      nextCloudHop = now + 820;
      pose = "jump";
    }

    function startle(now: number) {
      if (mode === "startle" || mode === "escape" || mode === "hopout" || now < scaredUntil) return;
      wheelOff();
      mode = "startle";
      pose = "startled";
      endAt = now + 285;
      scaredUntil = now + 2400;
      // Draw synchronously. There is no delayed reaction to the pointer.
      paint(now);
    }

    function finishWheel(now: number) {
      wheelOff();
      wheelCooldown = now + 14500;
      encounterCooldown.wheel = wheelCooldown;
      scene = "wheel";
      mode = "hopout";
      pose = "jump";
      origin = { x, y };
      to = pin({ x: x + (facing < 0 ? -105 : 105), y: y + random(12, 45) });
      facing = to.x >= x ? 1 : -1;
      travelStart = now;
      travelDuration = 780;
      destination = "roam";
    }

    function nearWheel() {
      if (!isVisible(wheel)) return false;
      const p = spotPoint("wheel");
      return Math.hypot(p.x - x, p.y - y) < 42;
    }

    function advance(now: number) {
      if (mouse && mode !== "startle" && mode !== "escape" && mode !== "hopout") {
        if (Math.hypot(x - mouse.x, y - 29 - mouse.y) < 90) {
          startle(now);
          if (mode === "startle") return;
        }
      }

      if (mode === "intro") {
        pose = "sleep";
        if (now >= endAt) walkTo(chooseSpot("cloud"), now);
      } else if (mode === "startle") {
        pose = "startled";
        if (now >= endAt) {
          const away = mouse
            ? pin({ x: x + (x >= mouse.x ? 1 : -1) * 200, y: y + (y >= mouse.y ? 1 : -1) * 55 })
            : freePoint();
          walkTo("roam", now, away, true);
        }
      } else if (mode === "walk" || mode === "escape" || mode === "hopout") {
        const progress = clamp((now - travelStart) / travelDuration, 0, 1);
        const ease = mode === "hopout" ? progress : progress * progress * (3 - 2 * progress);
        x = lerp(origin.x, to.x, ease);
        y = lerp(origin.y, to.y, ease);
        // Ordinary walking stays on the ground: only the wheel exit is a jump.
        if (mode === "hopout") y -= 36 * Math.sin(Math.PI * progress);
        pose = mode === "hopout" ? "jump" : mode === "escape" ? "run" : "walk";

        // A scene starts on contact, even if Cola was headed somewhere else.
        // Recently visited spots are ignored briefly to avoid getting stuck.
        if (mode === "walk") {
          const encounters: Spot[] = ["wheel", "bed", "cloud", "globe"];
          for (const spot of encounters) {
            if (!isVisible(spotElement(spot)) ||
                now < (encounterCooldown[spot] || 0) ||
                (spot === "wheel" && now < wheelCooldown)) continue;
            const place = spotPoint(spot);
            const threshold = spot === "globe" ? 53 : spot === "wheel" ? 52 : 39;
            if (Math.hypot(place.x - x, place.y - y) <= threshold) {
              if (spot === "wheel") { x = place.x; y = place.y; }
              startScene(spot, now);
              return;
            }
          }
        }

        if (progress >= 1) {
          if (mode === "escape" || mode === "hopout") {
            startScene("roam", now);
          } else if (destination !== "roam" && isVisible(spotElement(destination))) {
            startScene(destination, now);
          } else {
            startScene("roam", now);
          }
        }
      } else if (mode === "scene") {
        if (scene === "wheel") {
          pose = "run";
          const w = spotPoint("wheel");
          x = lerp(x, w.x, .13);
          y = lerp(y, w.y, .13);
          if (now >= endAt) finishWheel(now);
        } else if (scene === "bed") {
          pose = "sleep";
          const p = spotPoint("bed");
          x = lerp(x, p.x, .06); y = lerp(y, p.y, .06);
          if (now >= endAt) walkTo(chooseSpot("bed"), now);
        } else if (scene === "cloud") {
          if (cloudHopCount < 5 && now >= nextCloudHop) beginCloudHop(now);
          if (now < hopEnd) {
            const t = clamp((now - hopStart) / 440, 0, 1);
            x = lerp(hopFrom.x, hopTo.x, t);
            y = lerp(hopFrom.y, hopTo.y, t) - 21 * Math.sin(Math.PI * t);
            pose = "jump";
          } else if (cloudHopCount >= 5) {
            walkTo(chooseSpot("cloud"), now);
          } else {
            pose = "sit";
          }
        } else if (scene === "globe") {
          pose = "walk";
          const g = rect(globe);
          if (g && isVisible(globe)) {
            const elapsed = endAt - now;
            const angle = now / 420;
            const centerX = g.left + g.width * .54;
            const centerY = g.top + g.height * .57;
            x = lerp(x, centerX + Math.cos(angle) * g.width * .21, .11);
            y = lerp(y, centerY + Math.sin(angle) * g.height * .15, .11);
            facing = Math.sin(angle) > 0 ? -1 : 1;
          }
          if (now >= endAt) walkTo(chooseSpot("globe"), now);
        } else {
          pose = "sit";
          if (now >= endAt) walkTo(chooseSpot("roam"), now);
        }
      }
    }

    // Original tiny pixel sprites inspired by Cola's reference sheet.
    // All poses use a 24 x 20 grid (2 canvas pixels per art pixel).
    // A walking cat always has a side-facing body; only the sitting pose
    // occasionally turns her face toward the viewer.
    function paint(now: number) {
      ctx!.clearRect(0, 0, 48, 40);
      ctx!.imageSmoothingEnabled = false;
      ctx!.save();
      // Art is drawn with the head on the left; flip when she walks right.
      if (facing > 0) { ctx!.translate(48, 0); ctx!.scale(-1, 1); }

      const ink = "#101018";
      const fur = "#292a35";
      const shade = "#434551";
      const glint = "#5a5b67";
      const yellow = "#f8e24f";
      const nose = "#e0acb4";
      const white = "#f6f5f2";
      const p = (x: number, y: number, w: number, h: number, color: string) => {
        ctx!.fillStyle = color;
        ctx!.fillRect(Math.round(x) * 2, Math.round(y) * 2, w * 2, h * 2);
      };
      const frame = Math.floor(now / (pose === "run" ? 82 : 165)) % 4;
      const blink = pose !== "startled" &&
        Math.floor(now / 3000) % 5 === 0 && Math.floor(now / 145) % 5 === 0;
      const pairOfEyes = (lx: number, rx: number, yy: number, size = 2) => {
        if (blink) {
          p(lx, yy + 1, size, 1, glint);
          p(rx, yy + 1, size, 1, glint);
        } else {
          p(lx, yy, size, 2, yellow);
          p(rx, yy, size, 2, yellow);
        }
      };

      if (pose === "sit" && Math.floor(now / 4800) % 3 !== 2) {
        // Front-facing sitting cat with both paws planted and a swishing tail.
        const wag = Math.round(Math.sin(now / 410));
        p(16, 12, 3, 6, ink); p(18, 9, 2, 5, fur);
        p(19, 6 + wag, 2, 5, ink); p(19, 5 + wag, 3, 2, ink);
        p(8, 11, 9, 7, ink); p(9, 12, 7, 5, fur);
        p(9, 13, 2, 5, shade); p(14, 13, 2, 5, shade);
        p(8, 17, 3, 2, ink); p(14, 17, 3, 2, ink);
        p(12, 13, 1, 1, white);
        p(7, 2, 3, 5, ink); p(15, 2, 3, 5, ink);
        p(8, 3, 1, 2, shade); p(16, 3, 1, 2, shade);
        p(6, 6, 13, 8, ink); p(7, 7, 11, 6, fur);
        p(8, 7, 9, 1, shade);
        pairOfEyes(9, 14, 9);
        p(12, 12, 1, 1, nose);
      } else if (pose === "sleep") {
        // Curled cat with ears lowered and eyes closed.
        p(18, 15, 3, 3, ink); p(20, 13, 2, 4, ink);
        p(21, 11 + Math.round(Math.sin(now / 750)), 2, 3, fur);
        p(7, 13, 14, 6, ink); p(9, 12, 10, 6, fur);
        p(11, 13, 5, 1, shade);
        p(3, 10, 4, 4, ink); p(9, 10, 3, 4, ink);
        p(2, 12, 11, 6, ink); p(3, 13, 9, 4, fur);
        p(4, 13, 6, 1, shade);
        p(5, 15, 2, 1, glint); p(9, 15, 2, 1, glint);
        p(7, 17, 1, 1, nose); p(11, 16, 1, 1, white);
      } else if (pose === "jump") {
        // Fully extended flying leap, not the standing cat moved upward.
        p(18, 8, 4, 3, ink); p(21, 6, 2, 3, ink);
        p(22, 4, 2, 3, fur);
        p(8, 9, 12, 5, ink); p(9, 10, 10, 3, fur);
        p(12, 10, 5, 1, shade);
        p(16, 12, 5, 3, ink); p(20, 14, 3, 2, ink);
        p(10, 12, 4, 3, ink); p(8, 14, 4, 2, ink);
        p(0, 13, 4, 3, ink); p(1, 16, 3, 2, ink);
        p(3, 7, 3, 5, ink); p(8, 7, 3, 5, ink);
        p(2, 9, 10, 6, ink); p(3, 10, 8, 4, fur);
        pairOfEyes(4, 8, 11);
        p(7, 13, 1, 1, nose); p(10, 14, 1, 1, white);
      } else if (pose === "startled") {
        // Arched back, bottlebrush tail, wide eyes and two alarm pixels.
        p(20, 10, 3, 7, ink); p(21, 4, 2, 7, ink);
        p(22, 3, 2, 3, shade);
        p(10, 10, 11, 6, ink); p(12, 8, 8, 7, ink);
        p(12, 10, 8, 5, fur);
        p(12, 15, 2, 4, ink); p(18, 15, 2, 4, ink);
        p(10, 13, 2, 4, ink);
        p(2, 2, 3, 7, ink); p(8, 1, 3, 8, ink);
        p(3, 4, 1, 4, shade); p(9, 3, 1, 4, shade);
        p(2, 7, 10, 8, ink); p(3, 8, 8, 6, fur);
        p(4, 9, 2, 3, yellow); p(8, 9, 2, 3, yellow);
        p(7, 12, 1, 1, nose); p(10, 13, 1, 1, white);
        p(13, 4, 2, 2, "#d88e55"); p(13, 1, 2, 2, "#d88e55");
      } else if (pose === "sit") {
        // A second sitting silhouette, head turned sideways.
        const wag = Math.round(Math.sin(now / 390));
        p(18, 13, 3, 5, ink); p(20, 9 + wag, 2, 6, ink);
        p(21, 6 + wag, 2, 4, fur);
        p(10, 12, 10, 6, ink); p(11, 13, 8, 4, fur);
        p(10, 17, 4, 2, ink); p(17, 17, 3, 2, ink);
        p(11, 14, 1, 1, white);
        p(3, 4, 3, 5, ink); p(9, 4, 3, 5, ink);
        p(3, 7, 10, 8, ink); p(4, 8, 8, 5, fur);
        p(5, 9, 2, 2, yellow); p(9, 9, 2, 2, yellow);
        p(8, 12, 1, 1, nose);
      } else {
        // Standing, walking, running and pawing share one readable side-view.
        // Four gait frames use alternating diagonal leg pairs.
        const moving = pose === "walk" || pose === "run";
        const stride = moving
          ? (pose === "run" ? [-3, 1, 3, -1] : [-2, 0, 2, 0])[frame]
          : 0;
        const lift = moving && frame % 2 ? 1 : 0;
        const wag = Math.round(Math.sin(now / 370));
        p(18, 12 + lift, 3, 4, ink);
        p(20, 9 + wag, 2, 5, ink); p(21, 5 + wag, 2, 5, ink);
        p(22, 4 + wag, 2, 2, fur);
        // Rear pair behind the torso.
        p(11 - stride, 15 + lift, 2, 4 - lift, shade);
        p(18 + stride, 15 + lift, 2, 4 - lift, shade);
        p(8, 9 + lift, 12, 7, ink); p(9, 10 + lift, 10, 5, fur);
        p(10, 10 + lift, 7, 1, shade);
        // Foreground paws show the opposite phase, with small foot shifts.
        p(11 + stride, 15 + lift, 2, 4 - lift, ink);
        p(18 - stride, 15 + lift, 2, 4 - lift, ink);
        p(10 + stride, 18, 4, 2, ink);
        p(17 - stride, 18, 4, 2, ink);
        p(2, 3 + lift, 3, 5, ink); p(8, 3 + lift, 3, 5, ink);
        p(3, 4 + lift, 1, 2, shade); p(9, 4 + lift, 1, 2, shade);
        p(2, 7 + lift, 10, 7, ink); p(3, 8 + lift, 8, 5, fur);
        p(4, 8 + lift, 6, 1, shade);
        pairOfEyes(4, 8, 9 + lift);
        p(7, 12 + lift, 1, 1, nose);
        p(10, 13 + lift, 1, 1, white);
        if (pose === "paw") {
          // One raised paw for playing with the globe.
          p(8, 14, 3, 3, fur);
          p(6, 12 + (frame % 2), 3, 3, ink);
        }
      }
      ctx!.restore();
    }

    function display(now: number) {
      const bounce = pose === "run" ? Math.round(Math.sin(now / 76)) : 0;
      canvas!.style.transform = "translate3d(" + Math.round(x - 38) + "px, " +
        Math.round(y - 64 - bounce) + "px, 0)";
      paint(now);
    }

    function tick(now: number) {
      raf = requestAnimationFrame(tick);
      if (document.visibilityState !== "visible") return;
      if (now - lastDraw < 30) return;
      lastDraw = now;
      advance(now);
      display(now);
    }

    function pointerMoved(event: PointerEvent) {
      if (event.pointerType !== "mouse") return;
      mouse = { x: event.clientX, y: event.clientY };
      if (Math.hypot(x - mouse.x, y - 29 - mouse.y) < 90) startle(performance.now());
    }
    function pointerLeft() { mouse = null; }
    function visibilityChanged() {
      if (document.visibilityState === "hidden") {
        hiddenAt = performance.now();
      } else if (hiddenAt) {
        const elapsed = performance.now() - hiddenAt;
        endAt += elapsed;
        travelStart += elapsed;
        nextCloudHop += elapsed;
        hopStart += elapsed;
        hopEnd += elapsed;
        hiddenAt = 0;
      }
    }

    window.addEventListener("pointermove", pointerMoved, { passive: true });
    window.addEventListener("pointerout", pointerLeft, { passive: true });
    document.addEventListener("visibilitychange", visibilityChanged);

    const now = performance.now();
    if (colaMemory) {
      // Astro client-side navigation preserves Cola's position and activity.
      const memory = colaMemory;
      colaMemory = null;
      x = pin({ x: memory.x, y: memory.y }).x;
      y = pin({ x: memory.x, y: memory.y }).y;
      facing = memory.facing;
      if (memory.mode === "scene" && memory.spot !== "roam" &&
          isVisible(spotElement(memory.spot))) {
        startScene(memory.spot, now, Math.max(300, memory.remaining));
      } else if (memory.mode === "walk" || memory.mode === "escape" ||
          memory.mode === "hopout") {
        walkTo(memory.destination, now);
        travelDuration = Math.max(350, memory.remaining);
      } else {
        startScene("roam", now, Math.min(Math.max(memory.remaining, 500), 2600));
      }
    } else {
      // Exactly one entrance scene when the website is first loaded.
      const first = isVisible(cloud) ? spotPoint("cloud") : isVisible(bed) ? spotPoint("bed") : pin({ x, y });
      x = first.x; y = first.y;
      mode = "intro";
      pose = "sleep";
      scene = "cloud";
      destination = "cloud";
      endAt = now + random(3200, 5000);
    }
    display(now);

    if (!prefersReducedMotion.matches && window.innerWidth >= 590) {
      raf = requestAnimationFrame(tick);
    }

    colaCleanup = (remember: boolean) => {
      if (remember) colaMemory = {
        x, y, facing, mode, spot: scene, destination,
        remaining: mode === "walk" || mode === "escape" || mode === "hopout"
          ? Math.max(0, travelDuration - (performance.now() - travelStart))
          : Math.max(0, endAt - performance.now()),
      };
      cancelAnimationFrame(raf);
      wheelOff();
      window.removeEventListener("pointermove", pointerMoved);
      window.removeEventListener("pointerout", pointerLeft);
      document.removeEventListener("visibilitychange", visibilityChanged);
    };
  }

  document.addEventListener("astro:page-load", mountCola);
  document.addEventListener("astro:before-swap", () => {
    colaCleanup?.(true);
    colaCleanup = null;
  });
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", mountCola, { once: true });
  } else {
    mountCola();
  }
</script>
