---
/**
 * Cola is a self-animated pixel pet, not an external tracking widget.
 * She roams across the full visible browser window, with encounters at
 * the visitor globe, rotating word cloud, bed and climbing tree.
 * No network requests, cookies, or persistent state.
 */
---
<canvas
  class="cola-pet"
  data-cola-pet
  width="32"
  height="32"
  role="img"
  aria-label="Cola, a black pixel cat with a small white patch on her chest"
></canvas>

<script>
  type Point = { x: number; y: number };
  type Place = "roam" | "globe" | "cloud" | "bed" | "tree";
  type Pose = "walk" | "sit" | "sleep" | "paw" | "climb" | "flee";
  let teardownCola: (() => void) | null = null;

  function startCola() {
    teardownCola?.();
    teardownCola = null;
    const canvas = document.querySelector<HTMLCanvasElement>("[data-cola-pet]");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const globe = document.querySelector<HTMLElement>(".visitor-globe-canvas");
    const cloud = document.querySelector<HTMLElement>(".research-cloud-viewport");
    const bed = document.querySelector<HTMLElement>("[data-cola-bed]");
    const tree = document.querySelector<HTMLElement>("[data-cola-tree]");
    const mq = window.matchMedia("(prefers-reduced-motion: reduce)");
    const random = (low: number, high: number) => low + Math.random() * (high - low);
    const clamp = (n: number, a: number, b: number) => Math.max(a, Math.min(b, n));
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    let x = Math.min(90, window.innerWidth / 3);
    let y = window.innerHeight - 28;
    let facing = 1;
    let pose: Pose = "sit";
    let phase: "move" | "pause" | "escape" = "pause";
    let site: Place = "roam";
    let target: Place = "roam";
    let from: Point = { x, y };
    let to: Point = { x, y };
    let started = performance.now();
    let duration = 1;
    let pauseUntil = started + 1400;
    let scareCooldown = 0;
    let playStepAt = 0;
    let lastFrame = 0;
    let raf = 0;
    let pointer: Point | null = null;
    let lastClicked = false;
    let visible = true;
    let cloudStep = -1;
    let propsVisible = false;
    let globePlaying = false;

    const rect = (element: Element | null): DOMRect | null =>
      element ? element.getBoundingClientRect() : null;
    const within = (r: DOMRect | null) =>
      !!r && r.width > 10 && r.height > 10 && r.bottom > 65 &&
      r.top < window.innerHeight - 10 && r.right > 10 && r.left < window.innerWidth - 10;
    const pin = (p: Point): Point => ({
      x: clamp(p.x, 26, window.innerWidth - 27),
      y: clamp(p.y, 76, window.innerHeight - 20),
    });
    const center = (r: DOMRect): Point => ({ x: r.left + r.width / 2, y: r.top + r.height / 2 });

    // Keep the cat above the page rather than within the sticky, scrollable sidebar.
    function restingPlace(kind: Place): Point {
      const g = rect(globe);
      const c = rect(cloud);
      const b = rect(bed);
      const t = rect(tree);
      if (kind === "globe" && g) return pin({x: g.left + g.width * 0.66, y: g.top + g.height * 0.50});
      if (kind === "cloud" && c) return pin({x: c.left + c.width * 0.5, y: c.top + 4});
      if (kind === "bed" && b) return pin({x: b.left + b.width * 0.52, y: b.top + b.height * 0.77});
      if (kind === "tree" && t) return pin({x: t.left + t.width * 0.55, y: t.top + t.height * 0.82});
      return pin({x: random(36, Math.max(38, window.innerWidth - 36)), y: random(110, Math.max(112, window.innerHeight - 25))});
    }

    function chooseFreePoint(): Point {
      const width = window.innerWidth;
      const height = window.innerHeight;
      const main = rect(document.querySelector(".main-content"));
      const lanes = [
        () => ({ x: random(37, width - 38), y: height - 28 }),
        () => ({ x: random(37, width - 38), y: clamp(height * random(0.3, 0.72), 92, height - 28) }),
        () => main ? ({ x: main.left + random(16, Math.max(20, main.width - 28)), y: clamp(main.top + random(70, Math.max(90, height - 90)), 90, height - 28) }) :
          ({x: width * .55, y: height * .6}),
      ];
      return pin(lanes[Math.floor(Math.random() * lanes.length)]());
    }

    function pickPlace(): Place {
      const pool: Place[] = ["roam", "roam", "roam", "roam"];
      if (within(rect(globe))) pool.push("globe", "globe");
      if (within(rect(cloud))) pool.push("cloud", "cloud");
      if (within(rect(bed))) pool.push("bed", "bed");
      if (within(rect(tree))) pool.push("tree", "tree");
      return pool[Math.floor(Math.random() * pool.length)];
    }

    function removePlayClass() {
      if (globePlaying) globe?.classList.remove("cola-globe-play");
      globePlaying = false;
    }

    function walkTo(next: Place, now: number, forced?: Point) {
      removePlayClass();
      target = next;
      site = "roam";
      phase = "move";
      pose = "walk";
      from = {x, y};
      to = forced ?? (next === "roam" ? chooseFreePoint() : restingPlace(next));
      to = pin(to);
      started = now;
      const distance = Math.hypot(to.x - x, to.y - y);
      duration = clamp(distance / random(75, 115) * 1000, 450, 8200);
      facing = to.x >= x ? 1 : -1;
    }

    function startPause(now: number) {
      phase = "pause";
      site = target;
      pose = site === "bed" ? "sleep" :
        site === "globe" ? "paw" :
        site === "tree" ? "climb" : "sit";
      const min = site === "bed" ? 4500 : site === "roam" ? 1400 : 2600;
      const max = site === "bed" ? 10500 : site === "roam" ? 4800 : 7900;
      pauseUntil = now + random(min, max);
      playStepAt = now + 650;
      cloudStep = -1;
      if (site === "globe") {
        globe?.classList.add("cola-globe-play");
        globePlaying = true;
      }
    }

    function getCloudSteps(): Point[] {
      const area = cloud && rect(cloud);
      if (!area || !cloud) return [];
      const data = cloud.querySelector<HTMLCanvasElement>(".research-cloud-canvas")?.dataset.colaSteps;
      if (!data) return [];
      try {
        const parsed: unknown = JSON.parse(data);
        if (!Array.isArray(parsed)) return [];
        return parsed.filter((p: any) => typeof p.x === "number" && typeof p.y === "number" && p.depth > 0.40)
          .map((p: any) => pin({x: area.left + p.x, y: area.top + p.y - 12}));
      } catch {
        return [];
      }
    }

    function updateScene(now: number, dt: number) {
      if (site === "cloud") {
        const steps = getCloudSteps();
        if (steps.length && now > playStepAt) {
          // The rotating words form moving steps under Cola's paws.
          cloudStep = Math.floor(random(0, steps.length));
          playStepAt = now + random(900, 1800);
        }
        if (cloudStep >= 0 && steps.length) {
          const next = steps[cloudStep % steps.length];
          x = lerp(x, next.x, Math.min(0.10, dt / 160));
          y = lerp(y, next.y - Math.sin(now / 120) * 2.6, Math.min(0.10, dt / 160));
          facing = next.x >= x ? 1 : -1;
          pose = "walk";
        }
      } else if (site === "globe") {
        const g = rect(globe);
        if (g && within(g)) {
          // Little paw-taps at the ball as the 3D globe keeps spinning.
          const base = restingPlace("globe");
          x = lerp(x, base.x + Math.sin(now / 420) * 8, 0.06);
          y = lerp(y, base.y + Math.sin(now / 240) * 3, 0.06);
          pose = "paw";
          facing = -1;
        }
      } else if (site === "tree") {
        const t = rect(tree);
        if (t && within(t)) {
          const elapsed = (now - (pauseUntil - 7000)) / 7000;
          const rung = clamp(Math.floor(((now / 1350) % 4)), 0, 3);
          const shelf = t.bottom - (t.height * [0.18, 0.47, 0.72, 0.91][rung]);
          x = lerp(x, t.left + t.width * (rung % 2 ? 0.7 : 0.35), Math.min(0.08, dt / 160));
          y = lerp(y, shelf, Math.min(0.08, dt / 160));
          pose = "climb";
        }
      } else if (site === "bed") {
        const b = rect(bed);
        if (b && within(b)) {
          const place = restingPlace("bed");
          x = lerp(x, place.x, 0.04);
          y = lerp(y, place.y, 0.04);
        }
      }

      // The pet is responsive to a nearby mouse, but acts without one.
      if (pointer && now >= scareCooldown && pose !== "flee") {
        const dist = Math.hypot(pointer.x - x, pointer.y - (y - 28));
        if (dist < 90) {
          scareCooldown = now + 2200;
          const direction = x >= pointer.x ? 1 : -1;
          const away = pin({
            x: x + direction * random(125, 245),
            y: y + (y < pointer.y ? -1 : 1) * random(45, 110),
          });
          walkTo("roam", now, away);
          pose = "flee";
          phase = "escape";
          duration = random(500, 850);
          return;
        }
      }

      if (now >= pauseUntil) {
        walkTo(pickPlace(), now);
      }
    }

    // Pixel-art sprite, intentionally drawn locally without image assets.
    // Black fur, violet outlines, green eyes, and one white chest tuft.
    function draw(now: number) {
      ctx!.clearRect(0, 0, 32, 32);
      ctx!.save();
      if (facing < 0) { ctx!.translate(32, 0); ctx!.scale(-1, 1); }
      const ink = "#171722";
      const fur = "#272736";
      const shade = "#3f3e51";
      const shine = "#606074";
      const eye = "#b3e99a";
      const inner = "#9d6887";
      const white = "#f9f9f3";
      const nose = "#e2a4b1";
      const p = (x: number, y: number, w: number, h: number, color: string) => {
        ctx!.fillStyle = color;
        ctx!.fillRect(x, y, w, h);
      };
      const moving = pose === "walk" || pose === "flee" || pose === "climb";
      const phaseStep = Math.floor(now / (pose === "flee" ? 90 : 160)) % 2;
      const bob = moving ? phaseStep : 0;
      const sleeping = pose === "sleep";
      const blinking = sleeping || Math.floor(now / 2700) % 7 === 0 && Math.floor(now / 170) % 4 === 0;

      // Curled tail, which swishes even when she is sitting.
      const tailLift = Math.round(Math.sin(now / 340) * (sleeping ? 1 : 2));
      p(23, 23 + tailLift, 4, 4, ink);
      p(26, 18 + tailLift, 4, 7, ink);
      p(28, 14 + tailLift, 3, 5, fur);
      p(27, 12 + tailLift, 4, 3, shade);

      // Resting posture is curled and low.
      if (sleeping) {
        p(8, 22, 18, 8, ink);
        p(10, 21, 15, 7, fur);
        p(14, 23, 4, 3, white);
        p(6, 17, 18, 8, ink);
        p(7, 14, 4, 5, ink);
        p(18, 14, 4, 5, ink);
        p(8, 18, 14, 5, fur);
        p(10, 20, 3, 1, shine);
        p(18, 20, 3, 1, shine);
        p(15, 22, 2, 1, nose);
        p(6, 27, 21, 3, shade);
      } else {
        // Hind legs, body and front paws.
        p(9, 19 + bob, 17, 11, ink);
        p(11, 19 + bob, 13, 9, fur);
        p(10, 24 + bob, 4, 7 - bob, fur);
        p(20, 24 + (moving ? 1 - bob : 0), 4, 7, fur);
        p(10, 29, 6, 2, ink);
        p(19, 29, 6, 2, ink);
        p(12, 20 + bob, 3, 6, shade);

        // Small white tuft under the chin, deliberately unmistakable.
        p(15, 21 + bob, 4, 3, white);
        p(16, 24 + bob, 3, 2, white);
        p(17, 26 + bob, 1, 2, white);

        // Triangular cat ears, outlined one pixel at a time.
        p(7, 5 + bob, 6, 7, ink);
        p(19, 5 + bob, 6, 7, ink);
        p(8, 7 + bob, 3, 4, inner);
        p(21, 7 + bob, 3, 4, inner);
        p(6, 11 + bob, 20, 12, ink);
        p(8, 12 + bob, 17, 10, fur);
        p(9, 12 + bob, 13, 2, shade);
        p(10, 15 + bob, 3, 3, blinking ? fur : eye);
        p(20, 15 + bob, 3, 3, blinking ? fur : eye);
        if (!blinking) {
          p(11, 15 + bob, 1, 3, ink);
          p(21, 15 + bob, 1, 3, ink);
        } else {
          p(10, 17 + bob, 3, 1, shade);
          p(20, 17 + bob, 3, 1, shade);
        }
        p(16, 18 + bob, 2, 2, nose);
        p(14, 20 + bob, 2, 1, shine);
        p(18, 20 + bob, 2, 1, shine);
        p(5, 19 + bob, 4, 1, shade);
        p(24, 19 + bob, 4, 1, shade);
        if (pose === "paw") {
          p(7, 19 + bob, 5, 4, fur);
          p(5 + phaseStep * 2, 16 + bob, 5, 3, fur);
        }
        if (pose === "climb") {
          p(7, 17 + bob, 5, 4, shade);
          p(23, 17 + bob, 5, 4, shade);
        }
        p(12, 10 + bob, 4, 1, shine);
      }
      ctx!.restore();
    }

    function move(now: number) {
      const progress = clamp((now - started) / duration, 0, 1);
      // Gentle hopping between page surfaces; no snapping on arrival.
      const eased = progress * progress * (3 - 2 * progress);
      x = lerp(from.x, to.x, eased);
      const d = Math.hypot(from.x - to.x, from.y - to.y);
      const arc = d > 65 ? Math.min(34, d * 0.075) * Math.sin(Math.PI * progress) : 0;
      y = lerp(from.y, to.y, eased) - arc;
      if (progress >= 1) startPause(now);
    }

    function tick(now: number) {
      raf = requestAnimationFrame(tick);
      if (document.visibilityState !== "visible") { lastFrame = now; return; }
      const dt = Math.min(now - (lastFrame || now), 60);
      if (now - lastFrame < 32) return;
      lastFrame = now;

      if (!initialized) return;
      if (phase === "move" || phase === "escape") move(now);
      else updateScene(now, dt);

      const spriteBounce = (pose === "walk" || pose === "flee") ? Math.abs(Math.sin(now / 115)) * 2.5 : 0;
      canvas!.style.transform = "translate3d(" + Math.round(x - 32) + "px, " +
        Math.round(y - 60 - spriteBounce) + "px, 0)";
      if (phase !== "pause") pose = pose === "flee" ? "flee" : "walk";
      draw(now);
    }

    function onPointer(event: PointerEvent) {
      if (event.pointerType !== "mouse") return;
      pointer = { x: event.clientX, y: event.clientY };
      // Mouse movement interrupts the scene only when the cursor actually approaches Cola.
      const dist = Math.hypot(pointer.x - x, pointer.y - (y - 30));
      if (dist < 85 && performance.now() > scareCooldown) {
        const now = performance.now();
        scareCooldown = now + 2500;
        walkTo("roam", now, pin({
          x: x + (x >= pointer.x ? 1 : -1) * random(100, 180),
          y: y + (y >= pointer.y ? 1 : -1) * random(25, 75),
        }));
        phase = "escape";
        pose = "flee";
        duration = random(550, 850);
      }
    }

    function onVisibility() {
      lastFrame = performance.now();
    }
    window.addEventListener("pointermove", onPointer, { passive: true });
    document.addEventListener("visibilitychange", onVisibility);

    if (mq.matches || window.innerWidth < 590) {
      const place = restingPlace(within(rect(bed)) ? "bed" : "roam");
      x = place.x;
      y = place.y;
      pose = "sleep";
      canvas.style.transform = "translate3d(" + Math.round(x-32) + "px, " + Math.round(y-60) + "px, 0)";
      draw(performance.now());
      teardownCola = () => {
        window.removeEventListener("pointermove", onPointer);
        document.removeEventListener("visibilitychange", onVisibility);
        removePlayClass();
      };
      return;
    }

    if (bed && within(rect(bed))) {
      const p = restingPlace("bed");
      x = p.x; y = p.y;
      target = "bed";
      startPause(performance.now());
    } else {
      x = clamp(window.innerWidth * 0.38, 50, window.innerWidth - 35);
      y = window.innerHeight - 36;
      target = "roam";
      startPause(performance.now());
    }

    initialized = true;
    raf = requestAnimationFrame(tick);
    teardownCola = () => {
      cancelAnimationFrame(raf);
      window.removeEventListener("pointermove", onPointer);
      document.removeEventListener("visibilitychange", onVisibility);
      removePlayClass();
    };
  }

  document.addEventListener("astro:page-load", startCola);
  document.addEventListener("astro:before-swap", () => {
    teardownCola?.();
    teardownCola = null;
  });
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startCola, { once: true });
  } else {
    startCola();
  }
</script>
