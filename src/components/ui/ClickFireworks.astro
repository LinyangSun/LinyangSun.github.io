<script>
  // Tiny self-contained click fireworks, without a library or an overlay.
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const palette = ["#f59e0b", "#60a5fa", "#34d399", "#a78bfa"];

  document.addEventListener("pointerdown", (event: PointerEvent) => {
    if (reducedMotion.matches || event.pointerType === "touch" || event.button !== 0 || !event.isPrimary) return;

    const accent = getComputedStyle(document.documentElement).getPropertyValue("--accent").trim() || palette[0];
    const colors = [accent, ...palette];
    const count = 11;

    for (let index = 0; index < count; index++) {
      const spark = document.createElement("span");
      spark.className = "click-firework-spark";
      spark.style.left = event.clientX + "px";
      spark.style.top = event.clientY + "px";
      spark.style.backgroundColor = colors[index % colors.length];
      const size = index % 3 === 0 ? 5 : 4;
      spark.style.width = size + "px";
      spark.style.height = size + "px";
      document.body.appendChild(spark);

      const angle = index * 2 * Math.PI / count + Math.random() * 0.18;
      const distance = 24 + Math.random() * 28;
      const dx = Math.cos(angle) * distance;
      const dy = Math.sin(angle) * distance;
      const animation = spark.animate([
        { transform: "translate(-50%, -50%) scale(1)", opacity: 0.95 },
        { transform: "translate(calc(-50% + " + dx + "px), calc(-50% + " + dy + "px)) scale(0.05)", opacity: 0 },
      ], {
        duration: 470 + Math.round(Math.random() * 190),
        easing: "cubic-bezier(0.15, 0.65, 0.3, 1)",
        fill: "forwards",
      });
      animation.finished.then(() => spark.remove()).catch(() => spark.remove());
    }
  }, { passive: true });
</script>
