---
import { getCollection } from "astro:content";
import BaseListing from "../../layouts/BaseListing.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE, PAGES } from "../../config";

if (PAGES.blog.isActive === false) {
    return Astro.redirect("/404");
}

export async function getStaticPaths({ paginate }: any) {
    if (PAGES.blog.isActive === false) return [];
    const posts = await getCollection("posts");
    const sortedPosts = posts.sort(
        (a: any, b: any) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
    );

    if (sortedPosts.length === 0) {
        // Preserve /posts/ when the blog has no published posts.
        return [{
            params: { page: undefined },
            props: {
                page: {
                    data: [],
                    currentPage: 1,
                    lastPage: 1,
                    url: { prev: undefined, next: undefined }
                }
            }
        }];
    }

    return paginate(sortedPosts, { pageSize: SITE.postPerPage });
}

const { page } = Astro.props;
---

{page.data.length === 0 ? (
    <BaseLayout title={PAGES.blog.title}>
        <header class="page-header">
            <h1 class="page-title">{PAGES.blog.title}</h1>
        </header>
        <p>No posts yet.</p>
    </BaseLayout>
) : (
    <BaseListing
        collection="posts"
        title={PAGES.blog.title}
        subtitle={PAGES.blog.subtitle}
        page={page}
    />
)}
