---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllTags } from "../../utils/tags";
import Tag from "../../components/ui/Tag.astro";
import ContentHeader from "../../components/content/ContentHeader.astro";

const tags = await getAllTags();
const maxCount = Math.max(1, ...tags.map((tag) => tag.count));

// A stable, name-based layout keeps tags scattered without shifting positions
// on refresh, and avoids running any client-side JavaScript.
function hashTag(name: string): number {
    let hash = 2166136261;
    for (const character of name) {
        hash = Math.imul(hash ^ character.charCodeAt(0), 16777619);
    }
    return hash >>> 0;
}

const scatteredTags = [...tags].sort(
    (a, b) => hashTag(a.name) - hashTag(b.name) || a.name.localeCompare(b.name)
);

function tagLayout(name: string, count: number): string {
    const hash = hashTag(name);
    const x = ((hash & 255) / 255 - 0.5) * 18;
    const y = (((hash >>> 8) & 255) / 255 - 0.5) * 24;
    const rotation = (((hash >>> 16) & 255) / 255 - 0.5) * 5;
    const sizeVariation = ((hash >>> 24) & 255) / 255;
    const frequency = count / maxCount;
    const fontSize = 0.9 + 0.18 * frequency + 0.12 * sizeVariation;

    return `--tag-offset-x:${x.toFixed(1)}px;--tag-offset-y:${y.toFixed(1)}px;--tag-rotate:${rotation.toFixed(1)}deg;--tag-font-size:${fontSize.toFixed(2)}rem;`;
}
---

<BaseLayout title="Tags">
    <div class="content-container">
        <ContentHeader
            title="Tags"
            meta={[{ value: `${tags.length} unique topics` }]}
        />

        <div class="container-narrow pt-12">
            <div class="organic-tag-cloud" role="list" aria-label="Browse topics">
                {scatteredTags.map((tag) => (
                    <span
                        class="organic-tag-item"
                        role="listitem"
                        style={tagLayout(tag.name, tag.count)}
                    >
                        <Tag name={tag.name} count={tag.count} />
                    </span>
                ))}
            </div>

            {tags.length === 0 && (
                <p class="text-center text-text-muted mt-20 font-mono italic">
                    No tags found in your content yet.
                </p>
            )}
        </div>
    </div>
</BaseLayout>
