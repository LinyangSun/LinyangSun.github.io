---
import { getCollection } from "astro:content";
import BaseListing from "../../layouts/BaseListing.astro";
import { PAGES } from "../../config";

if (PAGES.teaching.isActive === false) {
    return Astro.redirect("/404");
}

const { title, subtitle } = PAGES.teaching;
const entries = (await getCollection("teaching")).sort((a, b) => {
    return (b.data.year || 0) - (a.data.year || 0);
});
---

<BaseListing collection="teaching" title={title} subtitle={subtitle} entries={entries} />
